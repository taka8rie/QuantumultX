# ============================================================
# Bilibili AdBlock for Quantumult X
# Quantumult X Native / Hybrid Edition
#
# 说明：
# 1. 保留普通 JSON / HTTP API Rewrite
# 2. 保留 grpc / RPC URL Reject
# 3. 保留 protobuf script-response-body
# 4. 同时兼容：
#      app.bilibili.com
#      app.biliapi.net
#      grpc.biliapi.net
# 5. 保留已验证可用的 1080P 高码率 / 4K 功能
# 6. 尽量缩小 MITM hostname 范围
#
# 2026-09-25
# ============================================================


# ============================================================
# MITM Hostname
# ============================================================

hostname = api.bilibili.com, api.biliapi.net, api.live.bilibili.com, api.vc.bilibili.com, app.bilibili.com, app.biliapi.net, grpc.biliapi.net


# ============================================================
# 1. 播放页 / 番剧 JSON
# ============================================================

# 播放页广告浮窗
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive url reject-dict

# VIP / Material 广告上报
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report url reject-dict

# 番剧播放页小卡片广告
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/cards url reject-dict

# 视频播放页下方商品推广
^https?:\/\/api\.(bilibili\.com|biliapi\.net)\/pgc\/season\/app\/related\/recommend\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 点击追番 Card / OGV Card
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards url reject-dict


# ============================================================
# 2. 直播间
# ============================================================

# 直播间商品广告浮窗
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d+\/ecommerce-user\/get_shopping_info\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 直播间广告
^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 3. 开屏 / 首页 Feed / Story / 搜索广场
# ============================================================

# 开屏广告
# 首页推荐 Feed
# Story
# 搜索广场
^https?:\/\/app\.(bilibili\.com|biliapi\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/story)?|search\/square) url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.AdBlock.response.min.js


# ============================================================
# 4. 番剧 / 影视页面
# ============================================================

# 追番页面
^https?:\/\/api\.(bilibili\.com|biliapi\.net)\/pgc\/page\/bangumi url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 观影 / Cinema 页面
^https?:\/\/api\.(bilibili\.com|biliapi\.net)\/pgc\/page\/cinema\/tab\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 5. 搜索 / 动态辅助接口
# ============================================================

# 搜索中的“大家都在搜”
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d+\/Search\/recommend_words url reject-dict

# 动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr url reject-dict

# HTTP API 搜索默认词
^https?:\/\/app\.(bilibili\.com|biliapi\.net)\/x\/v\d+\/search\/defaultwords url reject-dict


# ============================================================
# 6. Tab / UI / 外观
# ============================================================

# 标签页处理
^https?:\/\/app\.(bilibili\.com|biliapi\.net)\/x\/resource\/show\/tab url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 首页右上角活动入口
^https?:\/\/app\.(bilibili\.com|biliapi\.net)\/x\/resource\/top\/activity url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 7. 1080P 高码率 / 4K
#
# 你当前使用环境已经确认可正常工作
# 主要适用于部分旧版粉色 Bilibili 客户端
# 番剧和影视除外
# ============================================================

^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 8. gRPC / RPC URL Reject
#
# Quantumult X 实测：
#
# grpc.biliapi.net
# /bilibili.app.interface.v1.Search/DefaultWords
#
# 可以正常：
# REWRITE -> REJECT
# ============================================================

# 搜索默认词
# 同时兼容 Default 与 DefaultWords
^https?:\/\/(app\.bilibili\.com|app\.biliapi\.net|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default(Words)?$ url reject


# ============================================================
# 9. BiliProto / protobuf
#
# 当前 QX 实测已经确认：
#
# PlayURL / PlayView
#
# 可从：
#   app.bilibili.com
#   grpc.biliapi.net
#
# 命中 protobuf script-response-body
#
# 脚本日志可以识别：
#
# PATHs: bilibili.app.playurl.v1.PlayURL, PlayView
#
# 因此保留 protobuf 处理。
# ============================================================


# ------------------------------------------------------------
# 搜索结果去广告
# ------------------------------------------------------------

^https?:\/\/(app\.bilibili\.com|app\.biliapi\.net|grpc\.biliapi\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ------------------------------------------------------------
# 视频详情 / UP 主推荐 / Relates Feed
# ------------------------------------------------------------

^https?:\/\/(app\.bilibili\.com|app\.biliapi\.net|grpc\.biliapi\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo|RelatesFeed)$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ------------------------------------------------------------
# 动态综合页 / 视频动态
# ------------------------------------------------------------

^https?:\/\/(app\.bilibili\.com|app\.biliapi\.net|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ------------------------------------------------------------
# 视频播放 PlayURL / PlayView
#
# 已实际抓到：
#
# app.bilibili.com/
# bilibili.app.playurl.v1.PlayURL/PlayView
#
# grpc.biliapi.net/
# bilibili.app.playurl.v1.PlayURL/PlayView
#
# 均可进入 protobuf 脚本
# ------------------------------------------------------------

^https?:\/\/(app\.bilibili\.com|app\.biliapi\.net|grpc\.biliapi\.net)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


