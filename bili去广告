# ============================================================
# Bilibili AdBlock for Quantumult X
# QX Hybrid Edition
#
# 说明：
# 1. JSON / HTTP API Rewrite 正常启用
# 2. gRPC URL Reject 已在 Quantumult X 实测可用
# 3. protobuf response-body Rewrite 保留作为实验功能
# 4. MITM hostname 尽量收窄，避免整个 Bilibili 域名被解密
#
# 2026-09-25
# ============================================================


# ============================================================
# MITM Hostname
# ============================================================

hostname = api.bilibili.com, api.biliapi.net, api.live.bilibili.com, api.vc.bilibili.com, app.bilibili.com, app.biliapi.net, grpc.biliapi.net


# ============================================================
# 1. 播放页 / 番剧 JSON
# ============================================================

# 播放页广告浮窗
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive url reject-dict

# VIP Material 广告上报
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report url reject-dict

# 番剧播放页小卡片广告
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/cards url reject-dict

# 视频播放页下方商品推广
^https?:\/\/api\.(bilibili\.com|biliapi\.net)\/pgc\/season\/app\/related\/recommend\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 点击追番 Card
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards url reject-dict


# ============================================================
# 2. 直播间
# ============================================================

# 直播间商品广告浮窗
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d+\/ecommerce-user\/get_shopping_info\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 直播间广告
^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 3. 开屏 / 首页 Feed / Search Square
# ============================================================

# 开屏广告、首页 Feed、Story、搜索广场
^https?:\/\/app\.(bilibili\.com|biliapi\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/story)?|search\/square) url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.AdBlock.response.min.js


# ============================================================
# 4. 首页推荐
# ============================================================

# 首页推荐去广告
^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 5. 番剧 / 影视页面
# ============================================================

# 追番页面
^https?:\/\/api\.(bilibili\.com|biliapi\.net)\/pgc\/page\/bangumi url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 观影 / Cinema 页面
^https?:\/\/api\.(bilibili\.com|biliapi\.net)\/pgc\/page\/cinema\/tab\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 6. 搜索 / 动态辅助接口
# ============================================================

# 搜索中的“大家都在搜”
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d+\/Search\/recommend_words url reject-dict

# 动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr url reject-dict

# 搜索默认词 - HTTP API
^https?:\/\/app\.bilibili\.com\/x\/v\d+\/search\/defaultwords url reject-dict


# ============================================================
# 7. Tab / 外观
# ============================================================

# 标签页处理
^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 首页右上角活动
^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js

# 热搜 / 搜索广场
^https?:\/\/app\.bilibili\.com\/x\/v2\/search\/square url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 8. 高码率
#
# 主要针对部分旧版 Bilibili 客户端
# 如果出现账户页异常，注释掉即可
# ============================================================

^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\? url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.min.js


# ============================================================
# 9. gRPC URL Reject
#
# 已通过 Quantumult X 实测：
# grpc.biliapi.net 的 URL 可以被 QX 匹配并 REJECT。
# ============================================================

# 搜索默认词
^https?:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url reject

# 兼容 Default
^https?:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/Default$ url reject


# ============================================================
# 10. BiliProto / gRPC / protobuf
#
# 【实验功能】
#
# QX 已确认可以：
#   gRPC URL matching
#   URL reject
#
# 下面继续测试：
#   script-response-body
#   protobuf binary body
#
# 如果出现：
# - 页面加载异常
# - 视频详情异常
# - 搜索失败
# - 动态打不开
#
# 优先注释本区域，不要动上面的 JSON Rewrite。
# ============================================================


# ------------------------------------------------------------
# 搜索结果去广告
# ------------------------------------------------------------

^https?:\/\/grpc\.biliapi\.net\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ------------------------------------------------------------
# 视频详情 / UP 主推荐 / Relates Feed
# ------------------------------------------------------------

^https?:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo|RelatesFeed)$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ------------------------------------------------------------
# 动态综合页 / 视频动态
# ------------------------------------------------------------

^https?:\/\/grpc\.biliapi\.net\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ------------------------------------------------------------
# PlayURL
# ------------------------------------------------------------

^https?:\/\/grpc\.biliapi\.net\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$ url script-response-body https://r.sveir.xyz/Scripts/AdBlock/BiliBili/BiliBili.protobuf.min.js


# ============================================================
# 11. 我的页面
#
# 默认关闭。
# 如需清理“我的”页面，可以取消注释测试。
